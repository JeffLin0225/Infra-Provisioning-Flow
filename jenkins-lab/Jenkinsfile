pipeline {
    agent any

    // Jenkins 參數面板：使用者在網頁上可以選擇或輸入以下設定值
    parameters {
        choice(name: 'ACTION', choices: ['apply', 'destroy'], description: '選擇要「建立 (apply)」還是「銷毀 (destroy)」機器')
        string(name: 'VM_COUNT', defaultValue: '3', description: '建立幾台目標 VM (容器)')
        string(name: 'START_PORT', defaultValue: '2222', description: 'SSH 對外映射起始 Port')
        string(name: 'WEB_PORT_START', defaultValue: '8081', description: 'HTTP Web 服務起始 Port')
        choice(name: 'DEPLOY_TARGET', choices: ['web_servers', 'all', 'others', 'none'], description: 'Ansible 部署目標群組 (none = 跳過部署)')
    }

    stages {

        // 階段 1：從 Git 取得最新程式碼 (由 SCM 設定自動處理)
        stage('Checkout Code') {
            steps {
                echo '程式碼已從 Git/SCM 取得完成！'
            }
        }

        // 階段 2：初始化 Terraform 工作環境 (下載 Provider 等)
        stage('Terraform Init') {
            steps {
                dir('terraform-lab') {
                    sh 'terraform init'
                }
            }
        }

        // 階段 3：執行 Terraform 建置或銷毀
        // apply 時會同步產生 dynamic_hosts.ini 供 Ansible 使用
        stage('Terraform Execute') {
            steps {
                dir('terraform-lab') {
                    script {
                        if (params.ACTION == 'apply') {
                            sh """
                            terraform apply -auto-approve \
                                -var="container_count=${params.VM_COUNT}" \
                                -var="start_port=${params.START_PORT}" \
                                -var="web_port_start=${params.WEB_PORT_START}"
                            """
                        } else if (params.ACTION == 'destroy') {
                            sh "terraform destroy -auto-approve"
                        }
                    }
                }
            }
        }

        // 階段 4：建置應用程式 (語法檢查 + 打包成 zip)
        // 只在 apply 且需要部署時才執行
        stage('Build Application') {
            when {
                expression { params.ACTION == 'apply' && params.DEPLOY_TARGET != 'none' }
            }
            steps {
                dir('app-src') {
                    echo "開始進行應用程式打包測試..."
                    sh './build.sh'
                }
            }
        }

        // 階段 5：透過 Ansible 自動部署到目標容器
        // 需要先啟動 Conda 環境才能使用 ansible-playbook 指令
        stage('Ansible Deploy') {
            when {
                expression { params.ACTION == 'apply' && params.DEPLOY_TARGET != 'none' }
            }
            steps {
                dir('ansible') {
                    echo "準備呼叫 Conda 環境與 Ansible 進行發布..."
                    
                    sh """
                    #!/bin/bash
                    
                    # 啟動 Conda 環境 (Ansible 安裝在此環境中)
                    eval "\$(conda shell.bash hook)"
                    conda activate codedev
                    
                    # 顯示環境資訊供 Debug 確認
                    which python
                    ansible --version
                    
                    # 執行 Ansible 部署，使用 Terraform 動態產生的主機清單
                    ansible-playbook -i dynamic_hosts.ini demo_setup.yml --limit "${params.DEPLOY_TARGET}"
                    """
                }
            }
        }
    }
}
